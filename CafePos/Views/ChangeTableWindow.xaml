<Window x:Class="CafePos.Views.ChangeTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Masa Taşı / Birleştir" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="#121212"
        BorderBrush="#333333" BorderThickness="2">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK ALANI -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="20">
            <Grid>
                <TextBlock x:Name="TitleText" Text="MASA TAŞIMA İŞLEMİ" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Button Content="X" Width="40" Height="40" Background="Transparent" Foreground="#E53935" FontSize="24" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <!-- MASA LİSTESİ ALANI -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
            <ItemsControl x:Name="TablesItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Masaları yan yana sıralar, sığmazsa alt satıra geçer -->
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="140" Height="100" Margin="10" 
                                Background="{Binding StatusColor}" 
                                Foreground="White" BorderThickness="0" 
                                Click="TargetTable_Click">
                            <!-- Butonun daha yumuşak köşeli görünmesi için Template -->
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding TableName}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- BİLGİ ALANI -->
        <Border Grid.Row="2" Background="#1E1E1E" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Renk Açıklamaları -->
                <Ellipse Width="15" Height="15" Fill="#607D8B" Margin="0,0,5,0"/>
                <TextBlock Text="Boş (Taşıma)" Foreground="#AAAAAA" FontSize="14" Margin="0,0,20,0" VerticalAlignment="Center"/>

                <Ellipse Width="15" Height="15" Fill="#FF9800" Margin="0,0,5,0"/>
                <TextBlock Text="Dolu / Yeşil (Birleştirme)" Foreground="#AAAAAA" FontSize="14" Margin="0,0,20,0" VerticalAlignment="Center"/>

                <TextBlock Text="Yalnızca aynı masaya aktarım yapılamaz." Foreground="#E53935" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>