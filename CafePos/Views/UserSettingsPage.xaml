<Page x:Class="CafePos.Views.UserSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#121212" Title="Kullanıcı Ayarları">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PERSONEL VE YETKİ YÖNETİMİ" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <!-- Personel Listesi -->
                <ColumnDefinition Width="1*"/>
                <!-- Ekleme/Düzenleme Formu -->
            </Grid.ColumnDefinitions>

            <!-- SOL SÜTUN: MEVCUT PERSONELLER -->
            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="10" Padding="15" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Sistemdeki Personeller" Foreground="#AAAAAA" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <ListView x:Name="UsersListView" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="UsersListView_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Ad Soyad" Width="200" DisplayMemberBinding="{Binding FullName}"/>
                                <GridViewColumn Header="Kullanıcı Adı" Width="150" DisplayMemberBinding="{Binding UserName}"/>
                                <GridViewColumn Header="Rol" Width="150" DisplayMemberBinding="{Binding Role}"/>
                                <GridViewColumn Header="Durum" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- HATA ÇÖZÜMÜ: Converter yerine Style Trigger kullanıldı -->
                                            <TextBlock FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Pasif"/>
                                                        <Setter Property="Foreground" Value="#E53935"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="Aktif"/>
                                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- SAĞ SÜTUN: FORM -->
            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="FormTitle" Text="Yeni Personel Ekle" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                    <TextBlock Text="Ad Soyad" Foreground="#AAAAAA" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox x:Name="FullNameInput" Height="40" FontSize="16" Background="#2C2C2C" Foreground="White" BorderThickness="0" Padding="10,0" Margin="0,0,0,15"/>

                    <TextBlock Text="Kullanıcı Adı" Foreground="#AAAAAA" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox x:Name="UserNameInput" Height="40" FontSize="16" Background="#2C2C2C" Foreground="White" BorderThickness="0" Padding="10,0" Margin="0,0,0,15"/>

                    <TextBlock Text="Giriş PIN Kodu (4 Hane)" Foreground="#AAAAAA" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox x:Name="PinCodeInput" Height="40" FontSize="16" Background="#2C2C2C" Foreground="White" BorderThickness="0" Padding="10,0" Margin="0,0,0,15" MaxLength="4"/>

                    <TextBlock Text="Personel Rolü" Foreground="#AAAAAA" FontSize="14" Margin="0,0,0,5"/>
                    <ComboBox x:Name="RoleComboBox" Height="40" FontSize="16" Margin="0,0,0,15">
                        <ComboBoxItem Content="Yönetici (Admin)" Tag="1"/>
                        <ComboBoxItem Content="Kasiyer (Cashier)" Tag="2"/>
                        <ComboBoxItem Content="Garson (Waiter)" Tag="3"/>
                    </ComboBox>

                    <CheckBox x:Name="IsActiveCheckBox" Content="Aktif Çalışan" Foreground="White" FontSize="16" IsChecked="True" Margin="0,0,0,30"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="TEMİZLE" Height="45" Background="#333333" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Margin="0,0,5,0" Click="ClearForm_Click"/>
                        <Button Grid.Column="1" Content="KAYDET" Height="45" Background="#4CAF50" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Margin="5,0,0,0" Click="SaveUser_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>