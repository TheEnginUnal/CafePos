<UserControl x:Class="CafePos.Views.KitchenPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#121212">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="MUTFAK BEKLEYEN SİPARİŞLER" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="KitchenOrdersItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Adisyon Kartı -->
                        <Border Width="340" MinHeight="260" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="2" CornerRadius="10" Margin="0,0,15,15">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Üst Başlık (Masa ve Timer) -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TableName}" Foreground="#4CAF50" FontSize="22" FontWeight="Bold"/>

                                    <!-- Timer Ekranı -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⏱ " Foreground="#AAAAAA" FontSize="18"/>
                                        <TextBlock Text="{Binding TimerText}" Foreground="#FFC107" FontSize="20" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="#333333" Margin="0,5"/>

                                <!-- Sipariş Listesi -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}" Margin="0,10,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Adet (Büyütüldü) -->
                                                    <Border Grid.Column="0" Background="#333333" CornerRadius="5" Padding="12,5" Margin="0,0,10,0" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Quantity}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                                    </Border>

                                                    <!-- Ürün Adı ve Ürün Notu -->
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding ProductName}" Foreground="White" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                                        <!-- Ürün Notu Varsa Görünür -->
                                                        <TextBlock Text="{Binding ItemNote}" Foreground="#FFA726" FontSize="16" FontStyle="Italic" TextWrapping="Wrap" Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ItemNote}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ItemNote}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Genel Adisyon Notu -->
                                <Border Grid.Row="2" Background="#2C2C2C" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TicketNote}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TicketNote}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Adisyon Notu:" Foreground="#AAAAAA" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TicketNote}" Foreground="#FFCA28" FontSize="16" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Aksiyon Butonları -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Fırında" Height="45" Background="#FF9800" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Margin="0,0,5,0" Click="InOvenButton_Click" IsEnabled="{Binding IsOvenButtonEnabled}"/>
                                    <Button Grid.Column="1" Content="Hazır" Height="45" Background="#E53935" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Margin="5,0,0,0" Click="ReadyButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>