<UserControl x:Class="CafePos.Views.TablesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ÜST ARAÇ ÇUBUĞU -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Kendi Arama Kutumuz -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Masa Ara:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"/>
                <TextBox Width="200" Height="30" FontSize="16" Padding="5,0"/>
            </StackPanel>
            
            <!-- Lejant (Renklerin Anlamları) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <Ellipse Width="15" Height="15" Fill="Gray" Margin="0,0,5,0"/>
                    <TextBlock Text="Boş" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <Ellipse Width="15" Height="15" Fill="#FFA500" Margin="0,0,5,0"/>
                    <TextBlock Text="Bekliyor" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <Ellipse Width="15" Height="15" Fill="#E81123" Margin="0,0,5,0"/>
                    <TextBlock Text="Mutfak Hazır" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <Ellipse Width="15" Height="15" Fill="#107C10" Margin="0,0,5,0"/>
                    <TextBlock Text="Teslim Edildi" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- MASALAR (UniformGrid ile ekranı kaplayacak) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TablesItemsControl">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="5" 
                                HorizontalAlignment="Stretch" 
                                VerticalAlignment="Stretch"
                                MinHeight="100"
                                Background="{Binding StatusColor}" 
                                BorderThickness="0"
                                Click="TableButton_Click">

                            <!-- Standart TextBlock ile Masa Adı -->
                            <TextBlock Text="{Binding Name}" 
                                       Foreground="White" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>