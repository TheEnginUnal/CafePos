<Page x:Class="CafePos.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#121212" Title="Gelişmiş Raporlar">

    <Grid Margin="20">
        <TabControl Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="18"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="#2C2C2C" Padding="25,12" Margin="0,0,5,0" CornerRadius="8,8,0,0">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#0078D7" />
                                        <Setter Property="TextElement.Foreground" TargetName="ContentSite" Value="White" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="TextElement.Foreground" TargetName="ContentSite" Value="#AAAAAA" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ============================================== -->
            <!-- 1. GÜN SONU (Z RAPORU) SEKMESİ                 -->
            <!-- ============================================== -->
            <TabItem Header="Gün Sonu Raporu">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Tarih:" Foreground="#AAAAAA" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <DatePicker x:Name="ZReportDatePicker" Width="150" FontSize="16" SelectedDateChanged="ZReportDatePicker_SelectedDateChanged"/>
                        <Button Content="Z RAPORU YAZDIR" Width="180" Height="40" Background="#FF9800" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Margin="20,0,0,0" Click="PrintZReport_Click"/>
                    </StackPanel>

                    <!-- Gün Sonu Özet Kartları (Zaten C# tarafından " ₺" olarak basılıyor) -->
                    <UniformGrid Grid.Row="1" Columns="3" Rows="2">
                        <Border Background="#1E1E1E" CornerRadius="10" Padding="20" Margin="0,0,15,15" BorderBrush="#333333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TOPLAM CİRO (Net Gelir)" Foreground="#AAAAAA" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="ZTotalRevenueText" Text="0,00 ₺" Foreground="White" FontSize="36" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E1E1E" CornerRadius="10" Padding="20" Margin="0,0,15,15" BorderBrush="#107C10" BorderThickness="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="NAKİT TAHSİLAT" Foreground="#AAAAAA" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="ZTotalCashText" Text="0,00 ₺" Foreground="#4CAF50" FontSize="32" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E1E1E" CornerRadius="10" Padding="20" Margin="0,0,0,15" BorderBrush="#0078D7" BorderThickness="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="KREDİ KARTI TAHSİLAT" Foreground="#AAAAAA" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="ZTotalCreditCardText" Text="0,00 ₺" Foreground="#2196F3" FontSize="32" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E1E1E" CornerRadius="10" Padding="20" Margin="0,0,15,0" BorderBrush="#00BCD4" BorderThickness="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="UYGULANAN İNDİRİMLER" Foreground="#AAAAAA" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="ZTotalDiscountText" Text="0,00 ₺" Foreground="#00BCD4" FontSize="32" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E1E1E" CornerRadius="10" Padding="20" Margin="0,0,15,0" BorderBrush="#FFCA28" BorderThickness="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="TOPLAM İKRAM (Gider)" Foreground="#AAAAAA" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="ZTotalTreatsText" Text="0,00 ₺" Foreground="#FFCA28" FontSize="32" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E1E1E" CornerRadius="10" Padding="20" Margin="0,0,0,0" BorderBrush="#E53935" BorderThickness="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="TOPLAM İPTAL / İADE" Foreground="#AAAAAA" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="ZTotalRefundsText" Text="0,00 ₺" Foreground="#E53935" FontSize="32" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </TabItem>

            <!-- ============================================== -->
            <!-- 2. KASA RAPORU (Adisyon Detaylı) SEKMESİ       -->
            <!-- ============================================== -->
            <TabItem Header="Kasa Raporu">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Tarih:" Foreground="#AAAAAA" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <DatePicker x:Name="CashReportDatePicker" Width="150" FontSize="16" SelectedDateChanged="CashReportDatePicker_SelectedDateChanged"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sol: Adisyonlar -->
                        <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="10" Margin="0,0,15,0" Padding="10">
                            <ListView x:Name="TicketsListView" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="TicketsListView_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="10" HorizontalAlignment="Stretch">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TableName}" FontSize="18" FontWeight="Bold" Foreground="#4CAF50"/>
                                                <TextBlock Text="{Binding TimeAndStatus}" FontSize="14" Foreground="#AAAAAA" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>

                        <!-- Sağ: Detay Paneli -->
                        <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="10" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="TicketDetailsPanel" Visibility="Collapsed">
                                    <TextBlock x:Name="DetailTableNameText" Text="MASA: M-1" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                                    <TextBlock Text="Ödeme Dağılımı" FontSize="18" FontWeight="Bold" Foreground="#0078D7" Margin="0,0,0,10"/>
                                    <ListView x:Name="DetailPaymentsList" Background="Transparent" BorderThickness="0" Foreground="White" Margin="0,0,0,20">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding PaymentTypeStr}" FontSize="16"/>

                                                    <!-- TL DÜZELTMESİ YAPILAN YER 1 (Kasa Raporu Detay) -->
                                                    <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat={}{0:N2} ₺}" FontSize="16" FontWeight="Bold" Foreground="#4CAF50"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <TextBlock Text="İkram ve İptaller" FontSize="18" FontWeight="Bold" Foreground="#FF9800" Margin="0,0,0,10"/>
                                    <ListView x:Name="DetailTreatsList" Background="Transparent" BorderThickness="0" Foreground="White">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,5">
                                                    <TextBlock Text="{Binding ItemName}" FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding StatusAndStaff}" FontSize="14" Foreground="#AAAAAA"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================== -->
            <!-- 3. SATIŞ RAPORU SEKMESİ                        -->
            <!-- ============================================== -->
            <TabItem Header="Satış Raporu">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Content="BUGÜN" Width="100" Height="40" Background="#333333" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Click="SalesToday_Click"/>
                        <Button Content="BU AY" Width="100" Height="40" Background="#333333" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Click="SalesThisMonth_Click"/>
                        <Button Content="GEÇEN AY" Width="100" Height="40" Background="#333333" Foreground="White" BorderThickness="0" Margin="0,0,20,0" Click="SalesLastMonth_Click"/>

                        <TextBlock Text="Başlangıç:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <DatePicker x:Name="SalesStartDatePicker" Width="130" SelectedDateChanged="SalesCustomDate_Changed"/>
                        <TextBlock Text="Bitiş:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="15,0,10,0"/>
                        <DatePicker x:Name="SalesEndDatePicker" Width="130" SelectedDateChanged="SalesCustomDate_Changed"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="10" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ürün Adı" Foreground="#AAAAAA" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Satılan Adet" Foreground="#AAAAAA" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Toplam Gelir" Foreground="#AAAAAA" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ListView x:Name="SalesListView" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="18" VerticalAlignment="Center"/>

                                            <Border Grid.Column="1" Background="#333333" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,2">
                                                <TextBlock Text="{Binding TotalQuantity}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>

                                            <!-- TL DÜZELTMESİ YAPILAN YER 2 (Satış Raporu) -->
                                            <TextBlock Grid.Column="2" Text="{Binding TotalRevenue, StringFormat={}{0:N2} ₺}" FontSize="18" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>