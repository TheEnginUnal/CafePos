<Page x:Class="CafePos.Views.PaymentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#121212" Title="Ödeme Ekranı">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="HeaderTextBlock" Text="ÖDEME: M-1" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Left"/>
            <Button Content="GERİ DÖN" Width="120" Height="45" Background="#E53935" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right" Click="BackButton_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL SÜTUN: ETKİLEŞİMLİ SİPARİŞ LİSTESİ -->
            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="10" Padding="15" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Seçim/Adet" Foreground="#AAAAAA" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Ürün" Foreground="#AAAAAA" FontSize="16" FontWeight="Bold" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="Tutar" Foreground="#AAAAAA" FontSize="16" FontWeight="Bold"/>
                    </Grid>

                    <ListView x:Name="ConsolidatedOrderList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,5"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <!-- Tıklanabilir Ürün Satırı -->
                                <Button Background="Transparent" BorderThickness="0" Click="ProductItem_Click" HorizontalContentAlignment="Stretch">
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{Binding QuantityColor}" CornerRadius="4" Padding="5,4" HorizontalAlignment="Center" Width="70">
                                            <TextBlock Text="{Binding DisplayQuantity}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding ProductName}" Foreground="White" FontSize="18" TextWrapping="Wrap" Margin="10,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat={}{0:C}}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ORTA SÜTUN: AKSİYONLAR VE NUMPAD (Değişmedi) -->
            <Grid Grid.Column="1" Margin="0,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0" VerticalAlignment="Center">
                    <Button Content="TÜMÜ" Height="70" Width="120" Background="#0078D7" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,10" Click="SelectAll_Click"/>
                    <Button Content="YARISI" Height="70" Width="120" Background="#0078D7" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,10" Click="SelectHalf_Click"/>
                    <Button Content="KİŞİYE BÖL" Height="70" Width="120" Background="#9C27B0" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,10" Click="SplitByPerson_Click"/>
                    <Button Content="İNDİRİM (%)" Height="70" Width="120" Background="#FF9800" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Click="ApplyDiscount_Click"/>
                </StackPanel>

                <UniformGrid Grid.Column="1" Columns="3" Rows="4" VerticalAlignment="Center">
                    <UniformGrid.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="5"/>
                            <Setter Property="Background" Value="#2C2C2C"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="32"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </UniformGrid.Resources>
                    <Button Content="1" Click="NumPad_Click"/>
                    <Button Content="2" Click="NumPad_Click"/>
                    <Button Content="3" Click="NumPad_Click"/>
                    <Button Content="4" Click="NumPad_Click"/>
                    <Button Content="5" Click="NumPad_Click"/>
                    <Button Content="6" Click="NumPad_Click"/>
                    <Button Content="7" Click="NumPad_Click"/>
                    <Button Content="8" Click="NumPad_Click"/>
                    <Button Content="9" Click="NumPad_Click"/>
                    <Button Content="C" Background="#E53935" Click="NumPadClear_Click"/>
                    <Button Content="0" Click="NumPad_Click"/>
                    <Button Content="," Click="NumPad_Click"/>
                </UniformGrid>
            </Grid>

            <!-- SAĞ SÜTUN: FİNANSAL ÖZET VE GEÇMİŞ -->
            <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Kalan Toplam Hesap" Foreground="#AAAAAA" FontSize="16"/>
                        <TextBlock x:Name="RemainingAmountText" Text="0,00 ₺" Foreground="#FFCA28" FontSize="42" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="Seçili Tutar (Ödenecek)" Foreground="#AAAAAA" FontSize="16"/>
                        <Border Background="#2C2C2C" CornerRadius="5" Padding="10">
                            <TextBlock x:Name="SelectedAmountText" Text="0,00 ₺" Foreground="White" FontSize="48" FontWeight="Bold" TextAlignment="Right"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" x:Name="DiscountPanel" Visibility="Collapsed" Margin="0,0,0,15">
                        <TextBlock Text="Uygulanan İndirim" Foreground="#AAAAAA" FontSize="14"/>
                        <TextBlock x:Name="DiscountAmountText" Text="0,00 ₺" Foreground="#4CAF50" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Ödeme Geçmişi -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,10">
                        <TextBlock Text="Alınan Ödemeler" Foreground="#AAAAAA" FontSize="14" Margin="0,0,0,5"/>
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PastPaymentsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding PaymentTypeStr}" Foreground="White" FontSize="16"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat={}{0:C}}" Foreground="#4CAF50" FontSize="16" FontWeight="Bold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <Button Content="NAKİT" Height="70" Background="#107C10" Foreground="White" FontSize="26" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,15" Click="CashPayment_Click"/>
                        <Button Content="KREDİ KARTI" Height="70" Background="#0078D7" Foreground="White" FontSize="26" FontWeight="Bold" BorderThickness="0" Click="CreditCardPayment_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>