<UserControl x:Class="CafePos.Views.TableDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <UserControl.Resources>
        <Style x:Key="PosButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#364A5F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4B637D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PosButtonStyle}">
            <Setter Property="Height" Value="55"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <!-- YENİ: Alt Operasyon Butonları İçin Daha Küçük Stil -->
        <Style x:Key="OperationButtonStyle" TargetType="Button" BasedOn="{StaticResource PosButtonStyle}">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2,5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- SOL TARAF: KATEGORİLER VE ÜRÜNLER (Değişiklik Yok) -->
        <Grid Grid.Column="0" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="White" Click="BackButton_Click" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="Masalara Dön" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MenuGroupsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Width="140" Height="60" Style="{StaticResource PosButtonStyle}" Click="MenuGroupButton_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                <ItemsControl x:Name="ProductsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Height="100" Style="{StaticResource PosButtonStyle}" Click="ProductButton_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N2} ₺}" Foreground="#A0C9FF" FontSize="18" FontWeight="Bold" Margin="0,5,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- SAĞ TARAF: GÜNCELLENMİŞ ADİSYON PANELİ -->
        <Border Grid.Column="1" Background="#253342" CornerRadius="15,0,0,15" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TableNameText" Grid.Row="0" Text="MASA ADI" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <ListView x:Name="OrderItemsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="White">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0,5"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Ürün" Width="120" DisplayMemberBinding="{Binding ProductName}"/>

                            <GridViewColumn Header="Adet" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="-" Width="25" Height="25" Background="#4B637D" Foreground="White" BorderThickness="0" Click="DecreaseQty_Click"/>
                                            <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            <Button Content="+" Width="25" Height="25" Background="#4B637D" Foreground="White" BorderThickness="0" Click="IncreaseQty_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Fiyat" Width="80" DisplayMemberBinding="{Binding TotalPrice, StringFormat={}{0:N2} ₺}"/>

                            <GridViewColumn Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="İkram" Width="55" Height="30" Background="#9C27B0" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,5,0" Click="TreatItem_Click"/>
                                            <Button Content="Sil/İade" Width="55" Height="30" Background="#E53935" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="RemoveItem_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Adisyon Notu Alanı -->
                <Grid Grid.Row="2" Margin="0,10">
                    <TextBox x:Name="OrderNoteTextBox" Height="40" FontSize="16" 
                             Background="#1E1E1E" Foreground="White" 
                             BorderBrush="#4B637D" BorderThickness="1" Padding="10,8"/>

                    <TextBlock IsHitTestVisible="False" 
                               Text="Mutfağa / Baristaya İletilecek Not..." 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Left" 
                               Margin="12,0,0,0" 
                               Foreground="#888888" 
                               FontSize="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=OrderNoteTextBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Rectangle Grid.Row="2" Height="1" Fill="#364A5F" VerticalAlignment="Top"/>

                <!-- TOPLAM TUTAR ALANI (GÜNCELLENDİ) -->
                <StackPanel Grid.Row="3" Margin="0,5,0,15">
                    <!-- Önceden ödenen tutar varsa göster, yoksa gizle (C# ile yöneteceğiz) -->
                    <Grid x:Name="PaidAmountPanel" Visibility="Collapsed">
                        <TextBlock Text="Önceden Ödenen:" Foreground="#FFCA28" FontSize="16" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="PaidAmountText" Text="0.00 ₺" Foreground="#FFCA28" FontSize="16" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,5,0,0">
                        <TextBlock Text="KALAN TOPLAM:" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="GrandTotalText" Text="0.00 ₺" Foreground="#4CAF50" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <!-- İŞLEM BUTONLARI -->
                <StackPanel Grid.Row="4">
                    <Button Content="SİPARİŞİ MUTFAĞA GÖNDER" Style="{StaticResource ActionButtonStyle}" Background="#0078D7" Click="SendOrderButton_Click"/>

                    <!-- YENİ OPERASYON BUTONLARI -->
                    <UniformGrid Columns="4" Rows="1" Margin="0,0,0,5">
                        <Button Content="Teslim Edildi" Background="#4CAF50" Style="{StaticResource OperationButtonStyle}" Click="DeliveredButton_Click"/>
                        <Button Content="Barista Hazır" Background="#607D8B" Style="{StaticResource OperationButtonStyle}" Click="BaristaReadyButton_Click"/>
                        <Button Content="Mutfak Hazır" Background="#795548" Style="{StaticResource OperationButtonStyle}" Click="KitchenReadyButton_Click"/>
                        <Button Content="Masa Değiştir" Background="#673AB7" Style="{StaticResource OperationButtonStyle}" Click="ChangeTableButton_Click"/>
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CheckoutButton" Grid.Column="0" Content="ÖDEME AL" Background="#4CAF50" Style="{StaticResource ActionButtonStyle}" Margin="0,5,5,5" Click="PayButton_Click"/>
                        <Button Grid.Column="1" Content="FİŞ YAZDIR" Background="#FF9800" Style="{StaticResource ActionButtonStyle}" Margin="5,5,0,5" Click="PrintTicketButton_Click"/>
                    </Grid>

                    <Button x:Name="CancelButton" Content="TÜMÜNÜ İPTAL ET" Background="#E53935" Style="{StaticResource ActionButtonStyle}" Click="CancelOrderButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>